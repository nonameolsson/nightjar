{
	"name": "@nonameolsson/nightjar",
	"version": "0.2.0",
	"description": "Builds a repo's Features from its Tracker with nobody at the keyboard, one draft pull request per Feature.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nonameolsson/nightjar.git"
	},
	"homepage": "https://github.com/nonameolsson/nightjar#readme",
	"bugs": {
		"url": "https://github.com/nonameolsson/nightjar/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"claude-code",
		"agent",
		"automation",
		"github",
		"azure-devops"
	],
	"type": "module",
	"bin": {
		"nightjar": "dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./schema/factory.schema.json": "./schema/factory.schema.json"
	},
	"files": [
		"dist",
		"!dist/**/*.spec.*",
		"schema",
		"skills",
		"docs/ticket-contract.md",
		"plugin/nightjar-status",
		"!plugin/**/*.spec.ts",
		"src/status-shape.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit && tsc --noEmit -p plugin",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"schema": "tsx scripts/schema.ts",
		"leaks": "tsx scripts/leak-check.ts",
		"pack:check": "tsx scripts/pack-install.ts",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run leaks && npm run pack:check",
		"prepack": "npm run build"
	},
	"dependencies": {
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.10",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	}
}
